{
  "name": "notebooklm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy:app": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:jobs": "wrangler deploy --config dist/notebooklm_jobs/wrangler.json",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p containers/video-renderer",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm check:rules && pnpm typecheck && pnpm test",
    "check:rules": "node scripts/check-rules.mjs",
    "cf-typegen": "wrangler types -c wrangler.jsonc -c workers/jobs/wrangler.jsonc && wrangler types -c workers/jobs/wrangler.jsonc --include-runtime=false --env-interface JobsEnv workers/jobs/worker-configuration.d.ts",
    "cf:secrets": "node scripts/cf.mjs secrets",
    "cf:first-deploy": "node scripts/cf.mjs first-deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "env:pull": "op inject -i .env.template -o .env.local --force"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@google/genai": "^2.24.0",
    "@mozilla/readability": "^0.6.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "linkedom": "^0.18.13",
    "material-symbols": "^0.47.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "unpdf": "^1.8.1",
    "vinext": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "dotenv": "^18.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-css-modules": "^1.16.0",
    "vitest": "5.0.1",
    "wrangler": "^4.143.0"
  }
}
