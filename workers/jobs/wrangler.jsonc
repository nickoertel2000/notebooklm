{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "notebooklm-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // PDF-Parsing und große Kontexte brauchen mehr als die standardmäßigen 30 s CPU.
  "limits": {
    "cpu_ms": 300000
  },
  // Nahe der Datenbank (Neon, Frankfurt): jede Anfrage macht mehrere Queries.
  "placement": {
    "region": "aws:eu-central-1"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a6be78af969748cc96d01bce43186c0b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "notebooklm",
      "jurisdiction": "eu"
    }
  ],
  "exports": {
    "IngestSourceWorkflow": {
      "type": "workflow",
      "name": "notebooklm-ingest-source"
    },
    "ReportWorkflow": {
      "type": "workflow",
      "name": "notebooklm-report"
    },
    "AudioWorkflow": {
      "type": "workflow",
      "name": "notebooklm-audio"
    },
    "VideoWorkflow": {
      "type": "workflow",
      "name": "notebooklm-video"
    }
  },
  "containers": [
    {
      "class_name": "VideoRenderer",
      "image": "../../containers/video-renderer/Dockerfile",
      "image_build_context": "../../containers/video-renderer",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VIDEO_RENDERER",
        "class_name": "VideoRenderer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VideoRenderer"]
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "GEMINI_REPORT_MODELS": "gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite",
    "GEMINI_EMBEDDING_MODEL": "gemini-embedding-2",
    "GEMINI_TTS_MODELS": "gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-2-klein-4b",
    // Das Gratis-Kontingent (10.000 Neuronen/Tag) reicht für ca. 125 Bilder.
    "IMAGE_DAILY_LIMIT": "100",
    "VIDEO_SLIDE_CONCURRENCY": "3",
    "DEMO_EMAIL_DOMAIN": "demo.notebooklm.invalid"
  },
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  }
}
