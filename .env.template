BETTER_AUTH_SECRET=op://Development/NotebookLM/BETTER_AUTH_SECRET

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=op://Development/NotebookLM/GOOGLE_CLIENT_ID
