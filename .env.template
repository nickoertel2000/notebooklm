# Template aller Secrets
# Secrets pullen und in richtige env speichern
# pnpm env:pull

# Postgres – direkte Verbindung, kein Transaction-Pooler davor: Hyperdrive pooled
# selbst und nutzt Prepared Statements. → in .env.local speichern (Secret)
# DATABASE_URL: drizzle-kit (Migrationen, Studio)
DATABASE_URL=op://Development/NotebookLM/DATABASE_URL
# Lokale Verbindung für das Hyperdrive-Binding in `pnpm dev`
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=op://Development/NotebookLM/DATABASE_URL

# Better Auth — in .env.local speichern (Secrets)
# Secret generieren: npx better-auth secret
BETTER_AUTH_SECRET=op://Development/NotebookLM/BETTER_AUTH_SECRET

# Google Gemini
GEMINI_API_KEY=op://Development/NotebookLM/GEMINI_API_KEY


# Tavily — Websuche nach neuen Quellen (Discover), 1.000 Credits pro Monat gratis
# https://app.tavily.com — Gemini-Grounding mit Google-Suche hat im Gratis-Tarif kein Kontingent
TAVILY_API_KEY=op://Development/NotebookLM/TAVILY_API_KEY
